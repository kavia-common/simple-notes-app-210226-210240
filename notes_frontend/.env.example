# Backend base URL used by the React app to call the REST API.
# The app picks the first non-empty value:
#   1) REACT_APP_API_BASE
#   2) REACT_APP_BACKEND_URL
# If both are empty, it will use same-origin (useful behind a reverse proxy).
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000
